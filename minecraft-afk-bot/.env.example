# Minecraft server
MC_HOST=your-server.example.com
MC_PORT=25565

# Bot identity
MC_USERNAME=ServerAFK

# Set to the exact server version, e.g. 1.21.8.
# Leave empty to let Mineflayer detect it.
MC_VERSION=

# offline or microsoft
# Use offline for offline-mode servers.
MC_AUTH=offline

# Optional activity to reduce AFK kicks.
ACTIVITY_ENABLED=false
ACTIVITY_MIN_SECONDS=45
ACTIVITY_MAX_SECONDS=120

# Reconnect delay
RECONNECT_MIN_SECONDS=10
RECONNECT_MAX_SECONDS=30

# Render provides PORT automatically.
PORT=10000
